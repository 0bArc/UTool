{
  "id": "example.mod",
  "name": "Example Mod",
  "version": "0.1.0",
  "description": "Starter mod manifest for utool (see mods/example-mod/).",
  "author": "you",
  "target": {
    "gameId": "Icarus",
    "engineVersion": "4.27",
    "minGameVersion": "1.0.0"
