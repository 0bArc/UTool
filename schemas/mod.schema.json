{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utool.dev/schemas/mod.schema.json",
  "title": "utool Mod Manifest",
  "type": "object",
  "required": ["id", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Unique mod identifier (lowercase, dots, dashes)."
    },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "target": {
      "type": "object",
      "properties": {
        "gameId": { "type": "string" },
        "engineVersion": { "type": "string" },
        "minGameVersion": { "type": "string" },
        "maxGameVersion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "optional": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "contentRoots": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["content"]
    },
    "patchFiles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "JSON patch definitions applied at load time."
    },
    "codeProject": {
      "type": "string",
      "description": "Relative path to mod C# project (e.g. code/MyMod.csproj). If omitted, a single code/*.csproj is used."
    },
    "pak": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string",
          "description": "Relative path for built patch pak (e.g. dist/MyMod_P.pak)."
        },
        "mountPoint": {
          "type": "string",
          "description": "UE4 pak mount point (e.g. ../../../YourGame/)."
        },
        "keepCache": {
          "type": "boolean",
          "description": "When true, retain .cache after build-mod for faster rebuilds. Default false removes .cache."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
