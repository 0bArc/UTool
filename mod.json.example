  "contentRoots": ["content"],
  "patchFiles": ["patches/gameplay.json"],
  "codeProject": "code/ExampleMod.csproj",
  "pak": {
    "output": "dist/ExampleMod_P.pak",
    "mountPoint": "../../../Icarus/Content/data/",
    "sourcePak": "@icarus-data",
    "useUnrealPak": true
  }
}
