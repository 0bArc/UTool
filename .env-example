# Nexus Mods v3 upload (https://www.nexusmods.com/settings/api-keys)
NEXUSMODS_API_KEY=

# Week for `utool mod ship <week> --upload`. Must match the CLI week.
# After a full upload, utool.json sets lastShippedWeek; bump this before the next upload.
# Same-week override: --upload --single
UTOOL_UPDATE_VERSION=1

# Optional overrides
# NEXUSMODS_API_BASE=https://api.nexusmods.com/v3
